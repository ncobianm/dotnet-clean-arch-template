{
  "$schema": "http://json.schemastore.org/template",
  "author": "ncobianm",
  "classifications": [ "Web", "WebAPI", "Clean Architecture", "DDD" ],
  "identity": "ncobianm.cleanarch.template",
  "groupIdentity": "ncobianm.cleanarch",
  "name": "Clean Architecture + DDD Web API",
  "description": "Solución .NET con Clean Architecture + DDD (Api, Application, Contracts, Domain, Infrastructure).",
  "shortName": "cleanarch",
  "sourceName": "CleanArch",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "identifierSafeName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "stripNonIdentifierChars"
    },
    "problemDetailsFactoryName": {
      "type": "generated",
      "generator": "join",
      "replaces": "CleanArchProblemDetailsFactory",
      "fileRename": "CleanArchProblemDetailsFactory",
      "parameters": {
        "symbols": [
          { "type": "ref", "value": "identifierSafeName" },
          { "type": "const", "value": "ProblemDetailsFactory" }
        ]
      }
    }
  },
  "forms": {
    "stripNonIdentifierChars": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": ""
    }
  },
  "guids": [
    "CF5C68D8-583A-4F20-9803-3FE523972167",
    "EE6B95F2-5A53-4771-AB41-EF6E241EEBBC",
    "73E22490-1BEE-4F31-995A-78A5D2ACF42C",
    "A26D5982-CB38-435A-8ADD-559E4AC5CCDD",
    "43BF9403-F095-4E89-A0F5-708E2FC63C37"
  ],
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".template.config/**",
            ".git/**",
            ".github/**",
            ".idea/**",
            ".vs/**",
            "build/**",
            "**/bin/**",
            "**/obj/**",
            "**/*.user",
            "**/*.DotSettings.user"
          ]
        }
      ]
    }
  ]
}
